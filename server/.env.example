# Environment Variables Template for Vijay Medical Store Backend
# Copy this file to .env and fill in your values for production/staging:

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vijay_medical?retryWrites=true&w=majority

# Port for the Express server (Render/Railway/Heroku sets this automatically in production)
PORT=5000

# Secret key used to sign and verify JWT tokens (use a long, random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Node environment: 'development' or 'production'
NODE_ENV=development
